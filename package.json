{
  "name": "ghost-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@ghost-ai/web",
    "dev:api": "npm run dev --workspace=@ghost-ai/api",
    "build:web": "npm run build --workspace=@ghost-ai/web",
    "db:generate": "npm run db:generate --workspace=@ghost-ai/database",
    "db:validate": "npm run db:validate --workspace=@ghost-ai/database",
    "db:migrate": "npm run db:migrate --workspace=@ghost-ai/database",
    "db:deploy": "npm run db:deploy --workspace=@ghost-ai/database",
    "db:seed": "npm run db:seed --workspace=@ghost-ai/database",
    "db:verify": "npm run db:verify --workspace=@ghost-ai/database"
  }
}
